# Local assessment only. Leave the key empty to use labeled offline estimates.
# Get a key from https://console.groq.com/keys and save it in .env.local.
VITE_GROQ_API_KEY=

# Optional override; choose a model supporting strict structured outputs.
VITE_GROQ_MODEL=openai/gpt-oss-20b

# VITE_ values are exposed to the browser. Do not deploy this setup publicly.
